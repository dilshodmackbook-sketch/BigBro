# Telegram bot token (@BotFather)
BOT_TOKEN=

# Mini app ochiladigan HTTPS manzil (masalan https://bigbro.example.uz)
WEBAPP_URL=

# Veb server
HOST=0.0.0.0
PORT=8080

SHOP_NAME=BIG BRO

# Yangi navbatlar haqida xabar oladigan adminlar (username, vergul bilan)
ADMIN_USERNAMES=bunyodovf
# Ixtiyoriy: admin Telegram ID lari (vergul bilan)
ADMIN_IDS=

# Ustalar: "Ism:telegram_username" ; bilan ajratiladi. Username ixtiyoriy.
# Usta username ko'rsatilsa, unga ham xabar boradi va mini appda "Panel" ochiladi.
BARBERS=Usta 1;Usta 2

TIMEZONE=Asia/Tashkent
WORK_START=09:00
WORK_END=21:00
SLOT_MINUTES=30
DAYS_AHEAD=7
# Dam olish kunlari: 0=Dushanba ... 6=Yakshanba (masalan: 6)
DAYS_OFF=
# Tanaffus vaqtlari (masalan: 13:00-14:00)
BREAKS=
# Navbatdan necha daqiqa oldin mijozga eslatma yuborilsin
REMIND_BEFORE_MIN=60
